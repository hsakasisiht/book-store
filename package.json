{
  "name": "pagehaven-bookstore",
  "version": "1.0.0",
  "description": "PageHaven - Modern Digital Bookstore & Reading Hub",
  "private": true,
  "scripts": {
    "build": "npm install --prefix client && npm run build --prefix client && npm install --prefix server",
    "start": "npm run start --prefix server",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "test:acceptance": "node server/src/scripts/runAcceptanceTests.js"
  },
  "keywords": [
    "bookstore",
    "react",
    "express",
    "mongodb",
    "modern-ui"
  ],
